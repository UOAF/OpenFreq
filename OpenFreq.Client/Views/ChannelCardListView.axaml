<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:OpenFreqClient.Views"
             xmlns:viewModels="clr-namespace:OpenFreqClient.ViewModels"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:local="clr-namespace:OpenFreqAudio;assembly=OpenFreqAudio"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OpenFreqClient.Views.ChannelCardListView"
             x:DataType="viewModels:ChannelCardListViewModel"
             xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
             xmlns:models="clr-namespace:OpenFreq.Client.Models"
             xmlns:converters1="clr-namespace:OpenFreqClient.Converters">

    <UserControl.Resources>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <converters1:NullableDoubleConverter x:Key="NullableDoubleConverter" />
        <!-- ReSharper disable once Xaml.RedundantResource -->
        <StackPanel x:Key="Sample2View">
            <ProgressBar Classes="Circle" IsIndeterminate="True" />
            <Button Margin="0 16 0 0"
                    Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}">
                CLOSE
            </Button>
        </StackPanel>
    </UserControl.Resources>


    <ItemsControl ItemsSource="{Binding ChannelGroups}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <!-- Material Design Card for Group -->
                <controls:Card Margin="12,8" Padding="0">
                    <StackPanel>
                        <!-- ========================================== -->
                        <!-- GROUP HEADER (Always Visible) -->
                        <!-- ========================================== -->
                        <Grid ColumnDefinitions="*,Auto"
                              Background="{DynamicResource MaterialPrimaryDarkBrush}">

                            <!-- Group Info -->
                            <StackPanel Grid.Column="0" Spacing="4" Margin="16,12">
                                <TextBlock Text="{Binding Name}"
                                           Classes="Subtitle1"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RadioStationData.Preset.Name}"
                                           Classes="Caption"
                                           Opacity="0.7"
                                           IsVisible="{Binding RadioStationData.Preset, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>

                            <!-- Config Button -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        IsVisible="{Binding Settings.ModeIsGci}">
                                <Button
                                    IsVisible="{Binding EditMode}"
                                    Classes="Flat"
                                    Command="{Binding DeleteChannelGroupCommand}"
                                    Width="40" Height="40"
                                    ToolTip.Tip="Delete Group"
                                    Padding="8">
                                    <avalonia:MaterialIcon Kind="Trash" Width="24" Height="24"
                                                           Foreground="{DynamicResource MaterialValidationErrorBrush}" />
                                </Button>
                                <Button
                                    Classes="Flat"
                                    IsVisible="{Binding EditMode}"
                                    Command="{Binding ToggleEditingCommand}"
                                    Width="40" Height="40"
                                    ToolTip.Tip="Configure Group"
                                    Padding="8">
                                    <avalonia:MaterialIcon Kind="Cog" Width="24" Height="24" />
                                </Button>
                                <Button
                                    Classes="Flat"
                                    IsVisible="{Binding !EditMode}"
                                    Command="{Binding ToggleEditingCommand}"
                                    Width="40" Height="40"
                                    ToolTip.Tip="Configure Group"
                                    Padding="8">
                                    <avalonia:MaterialIcon Kind="CogOutline" Width="24" Height="24" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ========================================== -->
                        <!-- EXPANDABLE EDIT SECTION -->
                        <!-- ========================================== -->
                        <Border IsVisible="{Binding EditMode}"
                                Background="{DynamicResource MaterialPaperBrush}"
                                BorderBrush="{DynamicResource MaterialDividerBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="16">
                            <StackPanel Spacing="16">

                                <!-- Group Name -->
                                <TextBox Text="{Binding Name}"
                                         Watermark="Group name"
                                         Classes="Outline" />

                                <!-- Position Source -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Position Source"
                                               Classes="Caption"
                                               Opacity="0.7" />

                                    <!-- Fixed Position -->
                                    <RadioButton
                                        IsChecked="{Binding RadioStationData.Type, 
                                                 Converter={StaticResource EnumToBoolConverter}, 
                                                 ConverterParameter={x:Static models:RadioStationData+RadioStationType.STATIONARY}}"
                                        GroupName="PositionSource"
                                        Content="Fixed Position" />

                                    <Grid ColumnDefinitions="2*,*,Auto"
                                          ColumnSpacing="8"
                                          Margin="32,0,0,0"
                                          IsEnabled="{Binding RadioStationData.Type, 
                                          Converter={StaticResource EnumToBoolConverter}, 
                                          ConverterParameter={x:Static models:RadioStationData+RadioStationType.STATIONARY}}">

                                        <StackPanel Grid.Column="0">
                                            <TextBox Text="{Binding LatLonInput}"
                                                     Watermark="Lat Long (e.g., 37.12345 -122.98765)"
                                                     Classes="Outline"
                                                     Classes.error="{Binding HasCoordinateError}" />
                                            <TextBlock Text="{Binding CoordinateError}"
                                                       Foreground="{DynamicResource MaterialValidationErrorBrush}"
                                                       FontSize="11"
                                                       Margin="4,2"
                                                       IsVisible="{Binding HasCoordinateError}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox
                                                Text="{Binding AltitudeInput, Converter={StaticResource NullableDoubleConverter}}"
                                                Watermark="Alt (ft AGL)"
                                                Classes="Outline" VerticalAlignment="Center"
                                                Width="80" />
                                            <TextBlock Text="ft AGL" VerticalAlignment="Center" Margin="5, 0" />
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Theme="{StaticResource MaterialFlatButton}" Classes="primary"
                                                Command="{Binding OpenMapPickerCommand}"
                                                ToolTip.Tip="Pick on map"
                                                Width="40" Height="40">
                                            <avalonia:MaterialIcon Kind="MapMarker" Width="20" Height="20" />
                                        </Button>


                                    </Grid>

                                    <!-- Aircraft Callsign -->
                                    <StackPanel IsEnabled="{Binding IsAcmiConnected}">

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <RadioButton
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding RadioStationData.Type,
                                                 Converter={StaticResource EnumToBoolConverter},
                                                 ConverterParameter={x:Static models:RadioStationData+RadioStationType.ACMI}}"
                                                GroupName="PositionSource"
                                                Content="Track Aircraft" />
                                            <avalonia:MaterialIcon Kind="Info" IsVisible="{Binding !IsAcmiConnected}"
                                                                   Width="24" Height="24" VerticalAlignment="Center"
                                                                   Margin="25, 0, 0, 0" />
                                            <TextBlock IsVisible="{Binding !IsAcmiConnected}"
                                                       Text="Requires a Tacview connection" Margin="5, 0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <Grid ColumnDefinitions="*, *, Auto"
                                              ColumnSpacing="8"
                                              IsVisible="{Binding IsAcmiConnected}"
                                              IsEnabled="{Binding RadioStationData.Type, 
                                              Converter={StaticResource EnumToBoolConverter}, 
                                              ConverterParameter={x:Static models:RadioStationData+RadioStationType.ACMI}}">
                                            <ComboBox Grid.ColumnSpan="2"
                                                      ItemsSource="{Binding TacviewFlightCallsigns}"
                                                      SelectedItem="{Binding SelectedTacviewCallsign}"
                                                      PlaceholderText="Select callsign..."
                                                      Classes="Outline"
                                                      Margin="32,0,0,0"
                                                      HorizontalAlignment="Stretch" />
                                            <Button Grid.Column="2"
                                                    Theme="{StaticResource MaterialFlatButton}" Classes="primary"
                                                    Command="{Binding TrackSelectedAircraftCommand}"
                                                    ToolTip.Tip="Track on map"
                                                    Width="40" Height="40">
                                                <avalonia:MaterialIcon Kind="Map" Width="20" Height="20" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Station Preset -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Station Preset"
                                               Classes="Caption"
                                               Opacity="0.7" />
                                    <ComboBox ItemsSource="{x:Static local:RadioStationPresets.AllPresets}"
                                              SelectedItem="{Binding RadioStationData.Preset}"
                                              PlaceholderText="Select preset..."
                                              Classes="Outline"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4">
                                                    <TextBlock Text="{Binding Name}"
                                                               Classes="Body2" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Classes="Caption"
                                                               Opacity="0.7"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Preset Details (Collapsed by default) -->
                                <Expander Header="Preset Parameters"
                                          IsVisible="{Binding RadioStationData.Preset, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          IsExpanded="False">
                                    <Grid ColumnDefinitions="*,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="12"
                                          RowSpacing="8"
                                          Margin="8">

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="VHF TX Power" Classes="Caption" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding RadioStationData.Preset.TxPower_VHF_W, StringFormat='{}{0:F1} W'}"
                                                   Classes="Body2" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="UHF TX Power" Classes="Caption" />
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding RadioStationData.Preset.TxPower_UHF_W, StringFormat='{}{0:F1} W'}"
                                                   Classes="Body2" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Antenna Height" Classes="Caption" />
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   Text="{Binding RadioStationData.Preset.AntennaElevation_m, StringFormat='{}{0:F1} m'}"
                                                   Classes="Body2" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="VHF RX Sensitivity"
                                                   Classes="Caption" />
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                   Text="{Binding RadioStationData.Preset.RxSensitivity_VHF_dBm, StringFormat='{}{0:F1} dBm'}"
                                                   Classes="Body2" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="UHF RX Sensitivity"
                                                   Classes="Caption" />
                                        <TextBlock Grid.Row="4" Grid.Column="1"
                                                   Text="{Binding RadioStationData.Preset.RxSensitivity_UHF_dBm, StringFormat='{}{0:F1} dBm'}"
                                                   Classes="Body2" />
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- ========================================== -->
                        <!-- CHANNELS LIST -->
                        <!-- ========================================== -->
                        <ItemsControl ItemsSource="{Binding Channels}"
                                      Padding="8,8,8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <views:ChannelCardView Margin="4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ========================================== -->
                        <!-- ADD CHANNEL BUTTON (Bottom of each group) -->
                        <!-- ========================================== -->
                        <Button Command="{Binding AddChannelCommand}"
                                IsVisible="{Binding Settings.ModeIsGci}"
                                Classes="Flat"
                                HorizontalAlignment="Stretch"
                                Margin="12,4,12,12"
                                Padding="12,10">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center">
                                <avalonia:MaterialIcon Kind="Plus"
                                                       Width="20"
                                                       Height="20" />
                                <TextBlock Text="Add Channel"
                                           Classes="Body2"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:Card>
            </DataTemplate>
        </ItemsControl.ItemTemplate>

        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" Margin="4" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>

</UserControl>