<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenFreqClient.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
        xmlns:views="clr-namespace:OpenFreqClient.Views"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        xmlns:controls1="clr-namespace:OpenFreq.Client.Controls"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="OpenFreqClient.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/openfreq_client.ico"
        Title="OpenFreq Client"
        Width="800" Height="500">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- Peer section not matching current 3D mode -->
        <Style Selector="StackPanel.dimmed">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- Card Style -->
        <Style Selector="controls|Card">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- Section Header Style -->
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Input Label Style -->
        <Style Selector="TextBlock.InputLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Status Dot Style -->
        <Style Selector="Ellipse.StatusDot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Top Bar Styles -->
        <Style Selector="TextBlock.StatusText">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Container Query: compact status indicators when top bar narrows -->
        <!-- BMS: one indicator, compact at 550 -->
        <ContainerQuery Name="top-bar" Query="max-width:550">
            <Style Selector="StackPanel:not(.GciMode) > StackPanel > TextBlock.StatusText">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ContainerQuery>
        <!-- GCI: two indicators, compact at 730 -->
        <ContainerQuery Name="top-bar" Query="max-width:730">
            <Style Selector="StackPanel.GciMode > StackPanel > TextBlock.StatusText">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="Border.StatusSeparator">
                <Setter Property="Width" Value="0" />
                <Setter Property="Margin" Value="0" />
            </Style>
        </ContainerQuery>

    </Window.Styles>

    <dialogHostAvalonia:DialogHost Identifier="MainDialogHost">
        <!-- Side Drawer LEFT (Settings) -->
        <controls:NavigationDrawer Name="MainDrawer"
                                   LeftDrawerOpened="{Binding SettingsDrawerOpened}">
            <controls:NavigationDrawer.LeftDrawerContent>
                <!-- Settings Drawer -->
                <DockPanel Width="320">
                    <!-- Header with Mode Selection -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource MaterialPaperBrush}"
                            Padding="16"
                            BorderBrush="{DynamicResource MaterialDividerBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                <TextBlock Grid.Column="0"
                                           Text="Settings"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <!-- Theme toggle: light/dark -->
                                <Border Grid.Column="1"
                                        Background="{DynamicResource MaterialBackgroundBrush}"
                                        CornerRadius="8"
                                        Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="ThemeVariant"
                                                     Theme="{StaticResource MaterialButtonlikeRadioButton}"
                                                     IsChecked="{Binding !Settings.IsDarkMode}"
                                                     Padding="6"
                                                     ToolTip.Tip="Light mode">
                                            <avalonia:MaterialIcon Kind="WeatherSunny" Width="18" Height="18" />
                                        </RadioButton>
                                        <RadioButton GroupName="ThemeVariant"
                                                     Theme="{StaticResource MaterialButtonlikeRadioButton}"
                                                     IsChecked="{Binding Settings.IsDarkMode}"
                                                     Padding="6"
                                                     ToolTip.Tip="Dark mode">
                                            <avalonia:MaterialIcon Kind="WeatherNight" Width="18" Height="18" />
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Mode Toggle with Background -->
                            <Border Background="{DynamicResource MaterialBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="4">
                                <Grid ColumnDefinitions="*,*">
                                    <Grid.Styles>
                                        <Style Selector="RadioButton">
                                            <Setter Property="Theme"
                                                    Value="{StaticResource MaterialButtonlikeRadioButton}" />
                                        </Style>
                                    </Grid.Styles>
                                    <RadioButton Grid.Column="0"
                                                 GroupName="OwnPositionMode"
                                                 IsChecked="{Binding !Settings.ModeIsGci}"
                                                 Content="BMS"
                                                 FontWeight="Bold"
                                                 HorizontalAlignment="Stretch"
                                                 HorizontalContentAlignment="Center">
                                        <RadioButton.IsEnabled>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="Settings.IsWindowsPlatform" />
                                                <Binding Path="OpenFreqConnected" Converter="{x:Static BoolConverters.Not}" />
                                            </MultiBinding>
                                        </RadioButton.IsEnabled>
                                    </RadioButton>
                                    <RadioButton Grid.Column="1"
                                                 GroupName="OwnPositionMode"
                                                 IsChecked="{Binding Settings.ModeIsGci}"
                                                 Content="GCI"
                                                 FontWeight="Bold"
                                                 HorizontalAlignment="Stretch"
                                                 HorizontalContentAlignment="Center"
                                                 IsEnabled="{Binding !OpenFreqConnected}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Settings Content -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">

                            <!-- BMS Mode Settings -->
                            <StackPanel IsVisible="{Binding !Settings.ModeIsGci}">
                                <!-- Connection Status Card -->
                                <controls:Card>
                                    <StackPanel Margin="16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <avalonia:MaterialIcon Kind="Wan"
                                                                   Width="16" Height="16"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            <TextBlock Text="Connection" Classes="SectionHeader" Margin="0" />
                                        </StackPanel>
                                        <TextBlock Text="Settings controlled by BMS"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   Margin="0,0,0,8" />
                                        <CheckBox Content="Minimize on connect"
                                                  IsChecked="{Binding Settings.MinimizeOnConnect}" />
                                    </StackPanel>
                                </controls:Card>

                                <!-- Audio Card -->
                                <controls:Card>
                                    <StackPanel Margin="16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <avalonia:MaterialIcon Kind="VolumeHigh"
                                                                   Width="16" Height="16"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            <TextBlock Text="Audio Devices" Classes="SectionHeader" Margin="0" />
                                        </StackPanel>

                                        <TextBlock Text="Input" Classes="InputLabel" />
                                        <ComboBox ItemsSource="{Binding Settings.RecordingDeviceNames}"
                                                  SelectedIndex="{Binding Settings.RecordingDeviceIndex}"
                                                  IsEnabled="{Binding Settings.HasRecordingDevices}"
                                                  PlaceholderText="No input devices found"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="0,0,0,12" />

                                        <TextBlock Text="Output" Classes="InputLabel" />
                                        <ComboBox ItemsSource="{Binding Settings.PlaybackDeviceNames}"
                                                  SelectedIndex="{Binding Settings.PlaybackDeviceIndex}"
                                                  IsEnabled="{Binding Settings.HasPlaybackDevices}"
                                                  PlaceholderText="No output devices found"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="0,0,0,12" />

                                        <TextBlock Classes="InputLabel" Margin="0,4,0,4">
                                            <Run Text="Master Volume: " />
                                            <Run Text="{Binding Settings.MasterVolume, StringFormat={}{0:P0}}" />
                                        </TextBlock>
                                        <Slider Minimum="0" Maximum="2"
                                                Value="{Binding Settings.MasterVolume}"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True" />
                                    </StackPanel>
                                </controls:Card>

                                <!-- SFX Card -->
                                <controls:Card>
                                    <StackPanel Margin="16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <avalonia:MaterialIcon Kind="DeathStarVariant"
                                                                   Width="16" Height="16"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            <TextBlock Text="SFX" Classes="SectionHeader" Margin="0" />
                                        </StackPanel>

                                        <TextBlock Classes="InputLabel" Margin="0,0,0,4">
                                            <Run Text="Ambient Noise: " />
                                            <Run Text="{Binding Settings.AmbientNoiseVolume, StringFormat={}{0:P0}}" />
                                        </TextBlock>
                                        <Slider Minimum="0" Maximum="1"
                                                Value="{Binding Settings.AmbientNoiseVolume}"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                Margin="0,0,0,12" />

                                        <CheckBox Content="Sidetone"
                                                  IsChecked="{Binding Settings.SidetoneEnabled}"
                                                  Margin="0,0,0,4" />
                                        <StackPanel IsVisible="{Binding Settings.SidetoneEnabled}">
                                            <TextBlock Classes="InputLabel" Margin="0,4,0,4">
                                                <Run Text="Volume: " />
                                                <Run Text="{Binding Settings.SidetoneVolume, StringFormat={}{0:P0}}" />
                                            </TextBlock>
                                            <Slider Minimum="0" Maximum="1"
                                                    Value="{Binding Settings.SidetoneVolume}"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True" />
                                            <TextBlock Classes="InputLabel" Margin="0, 8, 0, 4" TextWrapping="Wrap" Text="Experimental feature:
                                            Sidetone with software will always have higher latency than real hardware solutions." FontStyle="Italic" />
                                        </StackPanel>
                                    </StackPanel>
                                </controls:Card>

                                <!-- BMS Audio Channels Card -->
                                <controls:Card>
                                    <StackPanel Margin="16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <avalonia:MaterialIcon Kind="Headphones"
                                                                   Width="16" Height="16"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            <TextBlock Text="BMS Audio Channels" Classes="SectionHeader" Margin="0" />
                                        </StackPanel>

                                        <TextBlock Text="Radio 1 (UHF / PRI)" Classes="InputLabel" />
                                        <controls1:AudioChannelSelector
                                            Pan="{Binding Settings.BmsRadio1Pan}"
                                            Margin="0,0,0,12" />

                                        <TextBlock Text="Radio 2 (VHF / AUX)" Classes="InputLabel" />
                                        <controls1:AudioChannelSelector
                                            Pan="{Binding Settings.BmsRadio2Pan}" />
                                    </StackPanel>
                                </controls:Card>

                                <controls:Card>
                                    <StackPanel Margin="16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <avalonia:MaterialIcon Kind="Waveform"
                                                                   Width="16" Height="16"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            <TextBlock Text="BMS Squelch Hotkeys" Classes="SectionHeader" Margin="0" />
                                        </StackPanel>

                                        <TextBlock Text="Radio 1 Squelch Toggle" Classes="InputLabel" />
                                        <Button
                                            Command="{Binding BeginCaptureUhfSquelchHotkeyCommand}"
                                            BorderBrush="{DynamicResource MaterialDividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,4"
                                            Margin="0,0,0,12"
                                            Classes="Flat"
                                            ToolTip.Tip="{Binding Settings.BmsUhfSquelchHotkeyDisplay }">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <avalonia:MaterialIcon Kind="KeyboardOutline"
                                                                       Width="18" Height="18" />
                                                <TextBlock Text="{Binding Settings.BmsUhfSquelchHotkeyDisplay}"
                                                           Classes="Body2"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Consolas,Courier New,monospace"
                                                           TextTrimming="LeadingCharacterEllipsis"
                                                           MaxWidth="180"/>
                                            </StackPanel>
                                        </Button>

                                        <TextBlock Text="Radio 2 Squelch Toggle" Classes="InputLabel" />
                                        <Button
                                            Command="{Binding BeginCaptureVhfSquelchHotkeyCommand}"
                                            BorderBrush="{DynamicResource MaterialDividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,4"
                                            Margin="0,0,0,12"
                                            Classes="Flat"
                                            ToolTip.Tip="{Binding Settings.BmsVhfSquelchHotkeyDisplay }">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <avalonia:MaterialIcon Kind="KeyboardOutline"
                                                                       Width="18" Height="18" />
                                                <TextBlock Text="{Binding Settings.BmsVhfSquelchHotkeyDisplay}"
                                                           Classes="Body2"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Consolas,Courier New,monospace"
                                                           TextTrimming="LeadingCharacterEllipsis"
                                                           MaxWidth="180"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </controls:Card>
                            </StackPanel>

                            <!-- GCI Mode Settings -->
                            <StackPanel IsVisible="{Binding Settings.ModeIsGci}">
                                <!-- Servers Card -->
                                <controls:Card>
                                    <StackPanel Margin="16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <avalonia:MaterialIcon Kind="Wan"
                                                                   Width="16" Height="16"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            <TextBlock Text="Connection" Classes="SectionHeader" Margin="0" />
                                        </StackPanel>

                                        <!-- OpenFreq Server -->
                                        <TextBlock Text="OpenFreq Server" Classes="InputLabel" />
                                        <TextBox PlaceholderText="Address:Port"
                                                 Text="{Binding Settings.OpenFreqServerAddress}"
                                                 IsEnabled="{Binding !OpenFreqConnected}"
                                                 Margin="0,0,0,8" />
                                        <TextBox PlaceholderText="Password"
                                                 PasswordChar="*"
                                                 Text="{Binding Settings.OpenFreqPassword}"
                                                 IsEnabled="{Binding !OpenFreqConnected}"
                                                 Margin="0,0,0,16" />

                                        <!-- Tacview Server -->
                                        <TextBlock Text="Tacview Server" Classes="InputLabel" />
                                        <TextBox PlaceholderText="Address:Port"
                                                 Text="{Binding Settings.TacviewServerAddress}"
                                                 IsEnabled="{Binding !OpenFreqConnected}"
                                                 Margin="0,0,0,8" />
                                        <TextBox PlaceholderText="Password"
                                                 PasswordChar="*"
                                                 Text="{Binding Settings.TacviewServerPassword}"
                                                 IsEnabled="{Binding !OpenFreqConnected}"
                                                 Margin="0,0,0,16" />

                                        <!-- Display Name -->
                                        <TextBlock Text="Display Name" Classes="InputLabel" />
                                        <TextBox PlaceholderText="Display Name"
                                                 Text="{Binding Settings.DisplayName}"/>
                                    </StackPanel>
                                </controls:Card>

                                <!-- Heightmap Card -->
                                <controls:Card>
                                    <StackPanel Margin="16">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <avalonia:MaterialIcon Kind="Map"
                                                                       Width="16" Height="16"
                                                                       Margin="0,0,8,0"
                                                                       Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                                <TextBlock Text="Heightmap" Classes="SectionHeader" Margin="0" />
                                            </StackPanel>
                                            <Ellipse Grid.Column="1"
                                                     Classes="StatusDot"
                                                     IsVisible="{Binding Settings.HeightmapPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="#10B981" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>

                                        <!-- BMS auto-detection (Windows + BMS found) -->
                                        <StackPanel IsVisible="{Binding Settings.BmsInstallFound}">
                                            <TextBlock Text="BMS Theater" Classes="InputLabel" />
                                            <ComboBox ItemsSource="{Binding Settings.TheaterDefinitions}"

                                                      SelectedItem="{Binding Settings.SelectedBmsTheater}"
                                                      IsEnabled="{Binding !OpenFreqConnected}"
                                                      HorizontalAlignment="Stretch"
                                                      Margin="0,0,0,12">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="Heightmap" Classes="InputLabel" />
                                            <Border Background="{DynamicResource MaterialBackgroundBrush}"
                                                    BorderBrush="{DynamicResource MaterialDividerBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="12,8"
                                                    ToolTip.Tip="{Binding Settings.HeightmapPath}">
                                                <Panel>
                                                    <TextBlock Text="{Binding Settings.HeightmapPath}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding Settings.HeightmapPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    <TextBlock Text="Select a BMS theater above"
                                                               FontSize="11"
                                                               Foreground="Red"
                                                               Opacity="0.7"
                                                               IsVisible="{Binding Settings.HeightmapPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                                </Panel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Manual selection (non-Windows or BMS not found) -->
                                        <StackPanel IsVisible="{Binding !Settings.BmsInstallFound}">
                                            <TextBlock Text="Theater" Classes="InputLabel" />
                                            <ComboBox ItemsSource="{Binding Settings.AvailableTheaterNames}"
                                                      SelectedItem="{Binding Settings.SelectedTheater}"
                                                      HorizontalAlignment="Stretch"
                                                      Margin="0,0,0,12" />

                                            <TextBlock Text="File" Classes="InputLabel" />
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource MaterialBackgroundBrush}"
                                                        BorderBrush="{DynamicResource MaterialDividerBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="12,8"
                                                        ToolTip.Tip="{Binding Settings.HeightmapPath}">
                                                    <Panel>
                                                        <TextBlock Text="{Binding Settings.HeightmapPath}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding Settings.HeightmapPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        <TextBlock
                                                            IsVisible="{Binding Settings.HeightmapPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                                            Text="No heightmap selected"
                                                            FontSize="11"
                                                            Foreground="Red"
                                                            Opacity="0.7" />
                                                    </Panel>
                                                </Border>
                                                <Button Grid.Column="1"
                                                        Click="HeightmapButton_OnClick"
                                                        Padding="12,8"
                                                        Margin="8,0,0,0">
                                                    <avalonia:MaterialIcon Kind="FolderOpen" Width="16" Height="16" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:Card>

                                <!-- Connect/Disconnect Buttons -->
                                <Button Content="Connect to Servers"
                                        Command="{Binding ConnectCommand}"
                                        IsEnabled="{Binding Settings.IsReadyToConnect}"
                                        IsVisible="{Binding !OpenFreqConnected}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,16"
                                        Height="40" />

                                <Button Content="Disconnect"
                                        Command="{Binding DisconnectCommand}"
                                        IsVisible="{Binding OpenFreqConnected}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,16"
                                        Height="40"
                                        Classes="accent" />

                                <!-- Audio Card -->
                                <controls:Card>
                                    <StackPanel Margin="16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <avalonia:MaterialIcon Kind="VolumeHigh"
                                                                   Width="16" Height="16"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            <TextBlock Text="Audio Devices" Classes="SectionHeader" Margin="0" />
                                        </StackPanel>

                                        <TextBlock Text="Input" Classes="InputLabel" />
                                        <ComboBox ItemsSource="{Binding Settings.RecordingDeviceNames}"
                                                  SelectedIndex="{Binding Settings.RecordingDeviceIndex}"
                                                  IsEnabled="{Binding Settings.HasRecordingDevices}"
                                                  PlaceholderText="No input devices found"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="0,0,0,12" />

                                        <TextBlock Text="Output" Classes="InputLabel" />
                                        <ComboBox ItemsSource="{Binding Settings.PlaybackDeviceNames}"
                                                  SelectedIndex="{Binding Settings.PlaybackDeviceIndex}"
                                                  IsEnabled="{Binding Settings.HasPlaybackDevices}"
                                                  PlaceholderText="No output devices found"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="0,0,0,12" />

                                        <TextBlock Classes="InputLabel" Margin="0,4,0,4">
                                            <Run Text="Master Volume: " />
                                            <Run Text="{Binding Settings.MasterVolume, StringFormat={}{0:P0}}" />
                                        </TextBlock>
                                        <Slider Minimum="0" Maximum="2"
                                                Value="{Binding Settings.MasterVolume}"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True" />
                                    </StackPanel>
                                </controls:Card>

                                <!-- SFX Card -->
                                <controls:Card>
                                    <StackPanel Margin="16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <avalonia:MaterialIcon Kind="DeathStarVariant"
                                                                   Width="16" Height="16"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            <TextBlock Text="SFX" Classes="SectionHeader" Margin="0" />
                                        </StackPanel>

                                        <TextBlock Classes="InputLabel" Margin="0,0,0,4">
                                            <Run Text="Ambient Noise: " />
                                            <Run Text="{Binding Settings.AmbientNoiseVolume, StringFormat={}{0:P0}}" />
                                        </TextBlock>
                                        <Slider Minimum="0" Maximum="1"
                                                Value="{Binding Settings.AmbientNoiseVolume}"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                Margin="0,0,0,12" />

                                        <CheckBox Content="Sidetone"
                                                  IsChecked="{Binding Settings.SidetoneEnabled}"
                                                  Margin="0,0,0,4" />
                                        <StackPanel IsVisible="{Binding Settings.SidetoneEnabled}">
                                            <TextBlock Classes="InputLabel" Margin="0,4,0,4">
                                                <Run Text="Volume: " />
                                                <Run Text="{Binding Settings.SidetoneVolume, StringFormat={}{0:P0}}" />
                                            </TextBlock>
                                            <Slider Minimum="0" Maximum="1"
                                                    Value="{Binding Settings.SidetoneVolume}"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True" />
                                            <TextBlock Classes="InputLabel" Margin="0, 8, 0, 4" TextWrapping="Wrap" Text="Experimental feature:
                                            Sidetone with software will always have higher latency than real hardware solutions." FontStyle="Italic" />
                                        </StackPanel>
                                    </StackPanel>
                                </controls:Card>
                            </StackPanel>

                            <!-- Debug Button (visible in both modes) -->
                            <Button IsVisible="{Binding DebugMode}"
                                    Command="{Binding DebugCommand}"
                                    Content="DEBUG"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,8,0,0" />

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </controls:NavigationDrawer.LeftDrawerContent>
            <!-- Main Content -->
            <DockPanel>
                <!-- Top Bar -->
                <controls:Card DockPanel.Dock="Top"
                               CornerRadius="0"
                               Margin="0"
                               Padding="12,8">
                    <DockPanel Container.Name="top-bar" Container.Sizing="Width">
                        <!-- Burger Menu Button -->
                        <Button Classes="BurgerButton Flat"
                                Command="{Binding ToggleSettingsDrawerCommand}"
                                DockPanel.Dock="Left"
                                Margin="0,0,8,0">
                            <avalonia:MaterialIcon Kind="Menu" Width="24" Height="24" />
                        </Button>

                        <!-- App Title -->
                        <TextBlock Text="OpenFreq"
                                   DockPanel.Dock="Left"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="0,0,24,0" />

                        <!-- Mode Toggle -->
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <StackPanel.IsEnabled>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="Settings.ModeIsGci" />
                                    <Binding Path="OpenFreqConnected" />
                                </MultiBinding>
                            </StackPanel.IsEnabled>

                            <StackPanel.Styles>
                                <Style Selector="RadioButton">
                                    <Setter Property="Theme" Value="{StaticResource MaterialButtonlikeRadioButton}" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="MinWidth" Value="100" />
                                    <Setter Property="Padding" Value="12, 8" />
                                    <Setter Property="Margin" Value="5, 0" />
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialBodyBrush}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Style>
                                <Style Selector="RadioButton:checked">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
                                </Style>
                            </StackPanel.Styles>

                            <RadioButton GroupName="3dMode"
                                         IsChecked="{Binding !Settings.Is3dMode}"
                                         ToolTip.Tip="Lobby Mode - Your voice will only be heard by other players in the Lobby without any effects.">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <avalonia:MaterialIcon Kind="Account" Width="20" Height="20" />
                                    <TextBlock Text="Lobby" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="3dMode"
                                         IsChecked="{Binding Settings.Is3dMode}"
                                         ToolTip.Tip="3D Mode - Your voice will only be heard by other players in the game.">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <avalonia:MaterialIcon Kind="ShieldAirplane" Width="20" Height="20" />
                                    <TextBlock Text="Game" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Connection Statuses (fill) -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="16"
                                    VerticalAlignment="Center"
                                    Classes.GciMode="{Binding Settings.ModeIsGci}">
                            <!-- OpenFreq Server Status -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        ToolTip.Tip="{Binding OpenFreqConnectionState, StringFormat='OpenFreq: {0}'}">
                                <Ellipse Classes="StatusDot">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding OpenFreqStatusColor}" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{Binding OpenFreqConnectionState, StringFormat='OpenFreq: {0}'}"
                                           Classes="StatusText" />
                            </StackPanel>

                            <!-- Separator -->
                            <Border Classes="StatusSeparator"
                                    Width="1"
                                    Height="16"
                                    Background="{DynamicResource MaterialDividerBrush}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding Settings.ModeIsGci}" />

                            <!-- Tacview Server Status -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding Settings.ModeIsGci}"
                                        ToolTip.Tip="{Binding AcmiConnectionStatus, StringFormat='Tacview: {0}'}">
                                <Ellipse Classes="StatusDot">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding TacviewStatusColor}" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{Binding AcmiConnectionStatus, StringFormat='Tacview: {0}'}"
                                           Classes="StatusText" />
                            </StackPanel>
                        </StackPanel>

                    </DockPanel>
                </controls:Card>

                <!-- IVC Warning Banner -->
                <Border DockPanel.Dock="Top"
                        Margin="5,0,5,12"
                        CornerRadius="8"
                        Background="{DynamicResource MaterialBackgroundBrush}"
                        BorderBrush="#F57C00"
                        BorderThickness="3,0,0,0"
                        IsVisible="{Binding IvcWarning}">
                    <Button Classes="Flat"
                            Command="{Binding KillIvcCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Padding="12,10"
                            Background="Transparent"
                            Cursor="Hand"
                            ToolTip.Tip="Click to kill IVC process">
                        <Grid ColumnDefinitions="Auto,*">
                            <avalonia:MaterialIcon Grid.Column="0"
                                                  Kind="AlertCircleOutline"
                                                  Width="20"
                                                  Height="20"
                                                  Foreground="#F57C00"
                                                  VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="IVC Conflict Detected"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialBodyBrush}"
                                           Margin="0,0,0,2" />
                                <TextBlock Text="Falcon BMS IVC must be closed to use OpenFreq in BMS mode."
                                           FontSize="12"
                                           Foreground="{DynamicResource MaterialBodyBrush}"
                                           Opacity="0.65"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Border>


                <!-- Status at bottom -->
                <Border DockPanel.Dock="Bottom"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource MaterialDividerBrush}">
                    <StackPanel Orientation="Horizontal" Margin="10,4" Spacing="5" HorizontalAlignment="Right">

                        <!-- Status / error message -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                            <!-- Amber dot — visible only on error -->
                            <Border Width="6" Height="6" CornerRadius="3"
                                    IsVisible="{Binding HasError}"
                                    Background="#FFB300"
                                    VerticalAlignment="Center" />
                            <TextBlock Classes.error="{Binding HasError}"
                                       Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       VerticalAlignment="Center">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialBodyBrush}" />
                                        <Setter Property="Opacity" Value="0.6" />
                                    </Style>
                                    <Style Selector="TextBlock.error">
                                        <Setter Property="Foreground" Value="#FFB300" />
                                        <Setter Property="Opacity" Value="0.9" />
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                        </StackPanel>

                        <Border Width="1" Height="10" VerticalAlignment="Center" Background="{DynamicResource MaterialBodyColor}"
                                Opacity="0.25" />

                        <!-- Version string -->
                        <TextBlock
                                   Text="{Binding AppVersion}"
                                   FontSize="11" Opacity="0.28"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Content Area - fills remaining space -->
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Column 0: Channel list view -->
                    <views:ChannelCardListView Grid.Column="0" DataContext="{Binding ChannelList}" />

                    <!-- Column 1: Participants Expander -->
                    <Expander Grid.Column="1"
                              Margin="0, 5"
                              ExpandDirection="Right"
                              IsExpanded="{Binding IsPeersPanelExpanded}"
                              Background="{DynamicResource MaterialPaperBrush}"
                              BorderBrush="{DynamicResource MaterialDividerBrush}"
                              BorderThickness="1,1,0,1"
                              IsVisible="{Binding OpenFreqConnected}">

                        <!-- Collapsed Header -->
                        <Expander.Header>
                            <Button Cursor="Hand"
                                    Classes="Flat"
                                    Background="Transparent"
                                    Padding="10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Command="{Binding TogglePeersPanelCommand}">
                                <Grid RowDefinitions="*,Auto">
                                    <!-- Vertical content area -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DistinctPeers, StringFormat='{}{0} Peers'}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Expander.Header>

                        <!-- Vertical content area -->

                        <!-- Expanded Content -->
                        <DockPanel Width="280">
                            <!-- Peers List -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>

                                    <!-- Lobby Section -->
                                    <StackPanel IsVisible="{Binding HasLobbyPeers}"
                                                Classes.dimmed="{Binding Settings.Is3dMode}">
                                        <Border Padding="10,6,10,4"
                                                BorderThickness="0,0,0,1">
                                            <TextBlock Text="{Binding LobbyPeerCount, StringFormat='LOBBY - {0}'}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.5"
                                                       LetterSpacing="1" />
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding LobbyPeerList}"
                                                      Margin="0,4,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,12">
                                                        <Border Padding="6,6,6,6"
                                                                BorderThickness="0,0,0,0.5"
                                                                Opacity="0.7">
                                                            <Grid ColumnDefinitions="*,Auto" Margin="10,0">
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock
                                                                        Text="{Binding FrequencyMhzString, StringFormat='{}{0:F3} MHz'}"
                                                                        FontSize="13"
                                                                        FontWeight="Medium" />
                                                                    <TextBlock FontSize="10"
                                                                               Opacity="0.6"
                                                                               Margin="0,1,0,0">
                                                                        <Run Text="{Binding Peers.Count}" />
                                                                        <Run Text="clients" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <Button Grid.Column="1"
                                                                        Classes="Flat"
                                                                        Padding="6,2"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip.Tip="Join in active location"
                                                                        IsVisible="{Binding CanJoin}"
                                                                        Command="{Binding JoinCommand}">
                                                                    <TextBlock Text="+" FontSize="16" FontWeight="Medium" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding Peers}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Padding="6,6,16,6"
                                                                            BorderThickness="{Binding TransmitBorderThickness}">
                                                                        <Border.Background>
                                                                            <SolidColorBrush Color="{Binding TransmitHighlightColor}" />
                                                                        </Border.Background>
                                                                        <Border.BorderBrush>
                                                                            <SolidColorBrush Color="{Binding TransmitBorderColor}" />
                                                                        </Border.BorderBrush>
                                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                                            <Ellipse Grid.Column="0" Width="5" Height="5"
                                                                                     VerticalAlignment="Center" Margin="10,0,8,0"
                                                                                     IsVisible="{Binding IsOwnUser}">
                                                                                <Ellipse.Fill><SolidColorBrush Color="Green" /></Ellipse.Fill>
                                                                            </Ellipse>
                                                                            <Ellipse Grid.Column="0" Width="5" Height="5"
                                                                                     VerticalAlignment="Center" Margin="10,0,8,0"
                                                                                     IsVisible="{Binding !IsOwnUser}">
                                                                                <Ellipse.Fill><SolidColorBrush Color="Transparent" /></Ellipse.Fill>
                                                                            </Ellipse>
                                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                                       Classes="Caption" FontWeight="{Binding PeerFontWeight}"
                                                                                       Text="{Binding Name}" />
                                                                            <Border Grid.Column="2" Background="Gold" CornerRadius="3"
                                                                                    Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                    IsVisible="{Binding IsTransmitting}" Opacity="0.2">
                                                                                <TextBlock Text="TX" FontSize="9" FontWeight="Bold" />
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- In Flight Section -->
                                    <StackPanel IsVisible="{Binding HasGamePeers}"
                                                Classes.dimmed="{Binding !Settings.Is3dMode}">
                                        <Border Padding="10,6,10,4"
                                                BorderThickness="0,0,0,1">
                                            <TextBlock Text="{Binding GamePeerCount, StringFormat='IN FLIGHT · {0}'}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.5"
                                                       LetterSpacing="1" />
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding GamePeerList}"
                                                      Margin="0,4,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,12">
                                                        <Border Padding="6,6,6,6"
                                                                BorderThickness="0,0,0,0.5"
                                                                Opacity="0.7">
                                                            <Grid ColumnDefinitions="*,Auto" Margin="10,0">
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock
                                                                        Text="{Binding FrequencyMhzString, StringFormat='{}{0:F3} MHz'}"
                                                                        FontSize="13"
                                                                        FontWeight="Medium" />
                                                                    <TextBlock FontSize="10"
                                                                               Opacity="0.6"
                                                                               Margin="0,1,0,0">
                                                                        <Run Text="{Binding Peers.Count}" />
                                                                        <Run Text="clients" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <Button Grid.Column="1"
                                                                        Classes="Flat"
                                                                        Padding="6,2"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip.Tip="Join in active location"
                                                                        IsVisible="{Binding CanJoin}"
                                                                        Command="{Binding JoinCommand}">
                                                                    <TextBlock Text="+" FontSize="16" FontWeight="Medium" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding Peers}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Padding="6,6,16,6"
                                                                            BorderThickness="{Binding TransmitBorderThickness}">
                                                                        <Border.Background>
                                                                            <SolidColorBrush Color="{Binding TransmitHighlightColor}" />
                                                                        </Border.Background>
                                                                        <Border.BorderBrush>
                                                                            <SolidColorBrush Color="{Binding TransmitBorderColor}" />
                                                                        </Border.BorderBrush>
                                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                                            <Ellipse Grid.Column="0" Width="5" Height="5"
                                                                                     VerticalAlignment="Center" Margin="10,0,8,0"
                                                                                     IsVisible="{Binding IsOwnUser}">
                                                                                <Ellipse.Fill><SolidColorBrush Color="Green" /></Ellipse.Fill>
                                                                            </Ellipse>
                                                                            <Ellipse Grid.Column="0" Width="5" Height="5"
                                                                                     VerticalAlignment="Center" Margin="10,0,8,0"
                                                                                     IsVisible="{Binding !IsOwnUser}">
                                                                                <Ellipse.Fill><SolidColorBrush Color="Transparent" /></Ellipse.Fill>
                                                                            </Ellipse>
                                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                                       Classes="Caption" FontWeight="{Binding PeerFontWeight}"
                                                                                       Text="{Binding Name}" />
                                                                            <Border Grid.Column="2" Background="Gold" CornerRadius="3"
                                                                                    Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                    IsVisible="{Binding IsTransmitting}" Opacity="0.2">
                                                                                <TextBlock Text="TX" FontSize="9" FontWeight="Bold" />
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Expander>
                </Grid>
            </DockPanel>
        </controls:NavigationDrawer>
    </dialogHostAvalonia:DialogHost>
</Window>
