<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenFreqClient.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
        xmlns:views="clr-namespace:OpenFreqClient.Views"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
        xmlns:local="clr-namespace:OpenFreq.Utilities"
        xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        xmlns:controls1="clr-namespace:OpenFreq.Client.Controls"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="OpenFreqClient.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/openfreq_client.ico"
        Title="OpenFreq Client"
        Width="800" Height="500">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- Card Style -->
        <Style Selector="controls|Card">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        
        <!-- Section Header Style -->
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        
        <!-- Input Label Style -->
        <Style Selector="TextBlock.InputLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Status Dot Style -->
        <Style Selector="Ellipse.StatusDot">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <dialogHostAvalonia:DialogHost Identifier="MainDialogHost">
        <!-- Side Drawer -->
        <controls:NavigationDrawer Name="LeftDrawer"
                                   LeftDrawerOpened="False">
            <controls:NavigationDrawer.LeftDrawerContent>
                <!-- Settings Drawer -->
                <DockPanel Width="320">
                    <!-- Header with Mode Selection -->
                    <Border DockPanel.Dock="Top" 
                            Background="{DynamicResource MaterialPaperBrush}"
                            Padding="16"
                            BorderBrush="{DynamicResource MaterialDividerBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Settings" 
                                       FontSize="18" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,12"/>
                            
                            <!-- Mode Toggle with Background -->
                            <Border Background="{DynamicResource MaterialBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="4">
                                <Grid ColumnDefinitions="*,*">
                                    <RadioButton Grid.Column="0"
                                                 GroupName="OwnPositionMode"
                                                 IsChecked="{Binding !Settings.ModeIsGci}"
                                                 Content="BMS"
                                                 FontWeight="Bold"
                                                 HorizontalAlignment="Stretch"
                                                 HorizontalContentAlignment="Center"
                                                 IsEnabled="{Binding !OpenFreqConnected}"/>
                                    <RadioButton Grid.Column="1"
                                                 GroupName="OwnPositionMode"
                                                 IsChecked="{Binding Settings.ModeIsGci}"
                                                 Content="GCI"
                                                 FontWeight="Bold"
                                                 HorizontalAlignment="Stretch"
                                                 HorizontalContentAlignment="Center"
                                                 IsEnabled="{Binding !OpenFreqConnected}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Settings Content -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            
                            <!-- BMS Mode Settings -->
                            <StackPanel IsVisible="{Binding !Settings.ModeIsGci}">
                                <!-- Connection Status Card -->
                                <controls:Card>
                                    <StackPanel Margin="16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <avalonia:MaterialIcon Kind="Wan" 
                                                                   Width="16" Height="16"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock Text="Connection" Classes="SectionHeader" Margin="0"/>
                                        </StackPanel>
                                        <TextBlock Text="Settings controlled by BMS" 
                                                   FontSize="12"
                                                   Opacity="0.7"/>
                                    </StackPanel>
                                </controls:Card>

                                <!-- Audio Card -->
                                <controls:Card>
                                    <StackPanel Margin="16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <avalonia:MaterialIcon Kind="VolumeHigh" 
                                                                   Width="16" Height="16"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock Text="Audio Devices" Classes="SectionHeader" Margin="0"/>
                                        </StackPanel>
                                        
                                        <TextBlock Text="Input" Classes="InputLabel"/>
                                        <ComboBox ItemsSource="{Binding Settings.RecordingDeviceNames}"
                                                  SelectedIndex="{Binding Settings.RecordingDeviceIndex}"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="0,0,0,12"/>
                                        
                                        <TextBlock Text="Output" Classes="InputLabel"/>
                                        <ComboBox ItemsSource="{Binding Settings.PlaybackDeviceNames}"
                                                  SelectedIndex="{Binding Settings.PlaybackDeviceIndex}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </controls:Card>

                                <!-- BMS Audio Channels Card -->
                                <controls:Card>
                                    <StackPanel Margin="16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <avalonia:MaterialIcon Kind="Headphones" 
                                                                   Width="16" Height="16"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock Text="BMS Audio Channels" Classes="SectionHeader" Margin="0"/>
                                        </StackPanel>
                                        
                                        <TextBlock Text="UHF" Classes="InputLabel"/>
                                        <controls1:AudioChannelSelector SelectedChannel="{Binding Settings.BmsUhfAudioChannel}"
                                                                        Margin="0,0,0,12"/>
                                        
                                        <TextBlock Text="VHF" Classes="InputLabel"/>
                                        <controls1:AudioChannelSelector SelectedChannel="{Binding Settings.BmsVhfAudioChannel}"/>
                                    </StackPanel>
                                </controls:Card>
                            </StackPanel>

                            <!-- GCI Mode Settings -->
                            <StackPanel IsVisible="{Binding Settings.ModeIsGci}">
                                <!-- Servers Card -->
                                <controls:Card>
                                    <StackPanel Margin="16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <avalonia:MaterialIcon Kind="Wan" 
                                                                   Width="16" Height="16"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock Text="Connection" Classes="SectionHeader" Margin="0"/>
                                        </StackPanel>
                                        
                                        <!-- OpenFreq Server -->
                                        <TextBlock Text="OpenFreq Server" Classes="InputLabel"/>
                                        <TextBox Watermark="Address:Port"
                                                 Text="{Binding Settings.OpenFreqServerAddress}"
                                                 IsEnabled="{Binding !OpenFreqConnected}"
                                                 Margin="0,0,0,8"/>
                                        <TextBox Watermark="Password"
                                                 PasswordChar="*"
                                                 Text="{Binding Settings.OpenFreqPassword}"
                                                 IsEnabled="{Binding !OpenFreqConnected}"
                                                 Margin="0,0,0,16"/>
                                        
                                        <!-- Separator -->
                                        <Separator Margin="0,0,0,16" 
                                                   Background="{DynamicResource MaterialDividerBrush}"/>
                                        
                                        <!-- Tacview Server -->
                                        <TextBlock Text="Tacview Server" Classes="InputLabel"/>
                                        <TextBox Watermark="Address:Port"
                                                 Text="{Binding Settings.TacviewServerAddress}"
                                                 IsEnabled="{Binding !OpenFreqConnected}"
                                                 Margin="0,0,0,8"/>
                                        <TextBox Watermark="Password"
                                                 PasswordChar="*"
                                                 Text="{Binding Settings.TacviewServerPassword}"
                                                 IsEnabled="{Binding !OpenFreqConnected}"/>
                                    </StackPanel>
                                </controls:Card>

                                <!-- Heightmap Card -->
                                <controls:Card>
                                    <StackPanel Margin="16">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <avalonia:MaterialIcon Kind="Map" 
                                                                       Width="16" Height="16"
                                                                       Margin="0,0,8,0"
                                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                <TextBlock Text="Heightmap" Classes="SectionHeader" Margin="0"/>
                                            </StackPanel>
                                            <Ellipse Grid.Column="1" 
                                                     Classes="StatusDot"
                                                     IsVisible="{Binding Settings.HeightmapPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="#10B981"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        
                                        <TextBlock Text="Theater" Classes="InputLabel"/>
                                        <ComboBox ItemsSource="{x:Static local:TheaterCoordinateConverter.AllTheaters}"
                                                  SelectedItem="{Binding Settings.SelectedTheater}"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="0,0,0,12"/>
                                        
                                        <TextBlock Text="File" Classes="InputLabel"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource MaterialBackgroundBrush}"
                                                    BorderBrush="{DynamicResource MaterialDividerBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="12,8"
                                                    ToolTip.Tip="{Binding Settings.HeightmapPath}">
                                                <Panel>
                                                    <TextBlock Text="{Binding Settings.HeightmapPath}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding Settings.HeightmapPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    <TextBlock IsVisible="{Binding Settings.HeightmapPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                                               Text="No heightmap selected"
                                                               FontSize="11"
                                                               Foreground="Red"
                                                               Opacity="0.7"/>
                                                </Panel>
                                            </Border>
                                            <Button Grid.Column="1"
                                                    Click="HeightmapButton_OnClick"
                                                    Padding="12,8"
                                                    Margin="8,0,0,0">
                                                <avalonia:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </controls:Card>

                                <!-- Connect/Disconnect Buttons -->
                                <Button Content="Connect to Servers"
                                        Command="{Binding ConnectCommand}"
                                        IsEnabled="{Binding Settings.IsReadyToConnect}"
                                        IsVisible="{Binding !OpenFreqConnected}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,16"
                                        Height="40"/>
                                
                                <Button Content="Disconnect"
                                        Command="{Binding DisconnectCommand}"
                                        IsVisible="{Binding OpenFreqConnected}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,16"
                                        Height="40"
                                        Classes="accent">
                                </Button>

                                <!-- Audio Card -->
                                <controls:Card>
                                    <StackPanel Margin="16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <avalonia:MaterialIcon Kind="VolumeHigh" 
                                                                   Width="16" Height="16"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock Text="Audio Devices" Classes="SectionHeader" Margin="0"/>
                                        </StackPanel>
                                        
                                        <TextBlock Text="Input" Classes="InputLabel"/>
                                        <ComboBox ItemsSource="{Binding Settings.RecordingDeviceNames}"
                                                  SelectedIndex="{Binding Settings.RecordingDeviceIndex}"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="0,0,0,12"/>
                                        
                                        <TextBlock Text="Output" Classes="InputLabel"/>
                                        <ComboBox ItemsSource="{Binding Settings.PlaybackDeviceNames}"
                                                  SelectedIndex="{Binding Settings.PlaybackDeviceIndex}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </controls:Card>
                            </StackPanel>

                            <!-- Debug Button (visible in both modes) -->
                            <Button IsVisible="{Binding DebugMode}"
                                    Command="{Binding DebugCommand}"
                                    Content="DEBUG"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,8,0,0"/>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </controls:NavigationDrawer.LeftDrawerContent>

            <!-- Main Content -->
            <DockPanel>
                <!-- App Bar -->
                <controls:ColorZone DockPanel.Dock="Top"
                                    Height="28"
                                    Classes.connected="{Binding OpenFreqConnected}">
                    <controls:ColorZone.Styles>
                        <Style Selector="controls|ColorZone">
                            <Setter Property="Mode" Value="Accent"/>
                        </Style>
                        <Style Selector="controls|ColorZone.connected">
                            <Setter Property="Mode" Value="PrimaryMid"/>
                        </Style>
                    </controls:ColorZone.Styles>

                    <DockPanel>
                        <!-- Menu Button -->
                        <Button Classes="Flat"
                                Click="MenuButton_OnClick"
                                DockPanel.Dock="Left"
                                VerticalAlignment="Center"
                                Margin="4,0,0,0"
                                Width="24"
                                Height="24">
                            <avalonia:MaterialIcon Kind="Menu" Width="24" Height="24"
                                                   Foreground="White"/>
                        </Button>

                        <!-- Title -->
                        <TextBlock Text="{Binding ConnectionStatusString}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   Foreground="White"/>
                    </DockPanel>
                </controls:ColorZone>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="Gray">
                    <ToggleSwitch Margin="10" Content=" 3D Mode" HorizontalAlignment="Right"
                                  IsChecked="{Binding Is3dMode}"
                                  IsEnabled="{Binding Settings.ModeIsGci}"/>
                </StackPanel>
                
                <!-- Status at bottom -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding StatusMessage}"/>

                <!-- Content Area - fills remaining space -->
                <Grid>
                    <ScrollViewer x:Name="ChannelGroupsScrollViewer">
                        <views:ChannelCardListView DataContext="{Binding ChannelList}"/>
                    </ScrollViewer>

                    <!-- Floating Action Button -->
                    <controls:FloatingButton Click="Button_OnClick"
                                             IsVisible="{Binding Settings.ModeIsGci}"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Bottom"
                                             Margin="24">
                        <controls:FloatingButton.Content>
                            <avalonia:MaterialIcon Kind="Plus" Width="24" Height="24"/>
                        </controls:FloatingButton.Content>
                    </controls:FloatingButton>
                </Grid>
            </DockPanel>
        </controls:NavigationDrawer>
    </dialogHostAvalonia:DialogHost>
</Window>