<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:viewModels="clr-namespace:OpenFreqClient.ViewModels"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:views="clr-namespace:OpenFreqClient.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OpenFreqClient.Views.ChannelCardView"
             Margin="16"
             x:DataType="viewModels:ChannelCardViewModel"
             xmlns:converters="using:OpenFreqClient.Converters">

    <UserControl.Resources>
        <converters:ChannelStatusToColorConverter x:Key="ChannelStatusToColorConverter" />
    </UserControl.Resources>

    <controls:Card MinWidth="200" PointerPressed="OnPttStart" PointerReleased="OnPttStop"
                   Background="{Binding Status, Converter={StaticResource ChannelStatusToColorConverter}}">
        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
            <StackPanel Margin="15" Spacing="10" Grid.Column="0" Grid.Row="0" IsVisible="{Binding !IsEditing}">
                <TextBlock Text="{Binding Name}" Classes="Body1">Name</TextBlock>
                <TextBlock Text="{Binding FrequencyMhzString, StringFormat={}{0} MHz}" Classes="Headline6" />
                <TextBlock Text="{Binding Type}" Classes="Body1">UHF</TextBlock>
                <TextBlock Text="{Binding Status}" Classes="Body1">RX</TextBlock>
                <ProgressBar Background="Gray" Value="{Binding SignalStrength}"></ProgressBar>
            </StackPanel>

            <!-- Editing Mode -->
            <StackPanel IsVisible="{Binding IsEditing}" Margin="15,15,30,10" Spacing="5" Grid.Column="0" Grid.Row="0"
                        VerticalAlignment="Top">
                <TextBox Text="{Binding Name}"
                         BorderBrush="Transparent"
                         Background="Transparent"
                         Watermark="Name"
                         Padding="0,5" />
                <TextBox Text="{Binding FrequencyMhzString}"
                         BorderBrush="Transparent"
                         Background="Transparent"
                         Watermark="Frequency (MHz)"
                         Padding="0,5" />
                <TextBlock Text="{Binding FrequencyError}"
                           Foreground="Red"
                           FontSize="11"
                           IsVisible="{Binding FrequencyError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ComboBox ItemsSource="{Binding ChannelTypes}"
                          SelectedItem="{Binding Type}"
                          Padding="0,5">
                </ComboBox>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="5" HorizontalAlignment="Left">
                    <Button
                        Theme="{StaticResource MaterialOutlineButton}"
                        Command="{Binding ToggleEditingCommand}"
                        IsEnabled="{Binding FrequencyError, Converter={x:Static ObjectConverters.IsNull}}"

                        MinWidth="80">
                        Save
                    </Button>

                    <Button Classes="accent"
                            Theme="{StaticResource MaterialOutlineButton}"
                            Command="{Binding DeleteChannelCommand}"
                            MinWidth="80">
                        Delete
                    </Button>
                </StackPanel>

            </StackPanel>

            <StackPanel IsVisible="{Binding IsEditing}" Margin="15,15,15,10" Spacing="10" Grid.Column="1" Grid.Row="0"
                        HorizontalAlignment="Left" MaxWidth="150" VerticalAlignment="Top">
                <HyperlinkButton IsVisited="False"
                                 Theme="{StaticResource MaterialHyperlinkButton}"
                                 Content="BMS Lobby 1"
                                 Command="{Binding BmsLobby1ClickedCommand}" />
                <HyperlinkButton IsVisited="False"
                                 Theme="{StaticResource MaterialHyperlinkButton}"
                                 Content="BMS Lobby 2"
                                 Command="{Binding BmsLobby2ClickedCommand}" />
            </StackPanel>

            <!-- Read Only Mode -->
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10" Spacing="10" HorizontalAlignment="Right"
                        IsVisible="{Binding !IsEditing}">

                <Button Classes="Flat" HorizontalAlignment="Right" Width="32" Height="32"
                        Command="{Binding ToggleEnabledCommand}" IsVisible="{Binding IsEnabled}">
                    <avalonia:MaterialIcon Kind="Circle" Width="24" Height="24" Foreground="Green" />
                </Button>

                <Button Classes="Flat" HorizontalAlignment="Right" Width="32" Height="32"
                        Command="{Binding ToggleEnabledCommand}" IsVisible="{Binding !IsEnabled}">
                    <avalonia:MaterialIcon Kind="CircleOutline" Width="24" Height="24" Foreground="Green" />
                </Button>

                <!-- Hotkey Section with Fixed Layout -->
                <Grid ColumnDefinitions="60,Auto,Auto" Height="32" HorizontalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               Text="{Binding HotkeyDisplay}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Margin="0,0,5,0"
                               IsVisible="{Binding HasHotkey}" />

                    <Button Grid.Column="1"
                            Classes="Flat"
                            Command="{Binding ClearHotkeyCommand}"
                            IsVisible="{Binding HasHotkey}"
                            ToolTip.Tip="Clear hotkey"
                            Width="32" Height="32"
                            Padding="0">
                        <avalonia:MaterialIcon Kind="Close" Width="16" Height="16" />
                    </Button>

                    <Button Grid.Column="2"
                            Classes="Flat"
                            Command="{Binding BeginCaptureHotkeyCommand}"
                            IsVisible="{Binding !IsCapturingHotkey}"
                            ToolTip.Tip="Set hotkey for PTT"
                            Width="32" Height="32"
                            Padding="0">
                        <avalonia:MaterialIcon Kind="Keyboard" Width="24" Height="24" />
                    </Button>

                    <Button Grid.Column="2"
                            Classes="Flat"
                            IsEnabled="False"
                            IsVisible="{Binding IsCapturingHotkey}"
                            Width="32" Height="32"
                            Padding="0">
                        <avalonia:MaterialIcon Kind="Keyboard" Width="24" Height="24" Foreground="Red" />
                    </Button>
                </Grid>

                <Button Classes="Flat" Command="{Binding ToggleEditingCommand}" HorizontalAlignment="Right" Width="32"
                        Height="32">
                    <avalonia:MaterialIcon Kind="Edit" Width="24" Height="24" />
                </Button>
            </StackPanel>

        </Grid>
    </controls:Card>
</UserControl>