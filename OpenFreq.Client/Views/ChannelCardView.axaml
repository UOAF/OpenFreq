<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:viewModels="clr-namespace:OpenFreqClient.ViewModels"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OpenFreqClient.Views.ChannelCardView"
             x:DataType="viewModels:ChannelCardViewModel"
             xmlns:converters="using:OpenFreqClient.Converters"
             xmlns:converters1="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
             xmlns:controls1="clr-namespace:OpenFreq.Client.Controls"
             xmlns:models="clr-namespace:OpenFreq.Client.Models"
             xmlns:converters2="clr-namespace:OpenFreq.Client.Converters"
             xmlns:models1="clr-namespace:OpenFreqClient.Models">
    <UserControl.Resources>
        <converters:ChannelStatusToColorConverter x:Key="ChannelStatusToColorConverter" />
        <converters:ChannelTransmissionStatusToColorConverter x:Key="ChannelTransmissionStatusToColorConverter" />
        <converters:BoolToGreenGrayConverter x:Key="BoolToGreenGrayConverter" />
        <converters:HotkeyTooltipConverter x:Key="HotkeyTooltipConverter" />
        <converters1:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <converters2:InvertedEnumToBoolConverter x:Key="InvertedEnumToBoolConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Active transmission state -->
        <Style Selector="controls|Card.transmitting">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>

    <!-- Main Card -->
    <controls:Card Padding="16"
                   PointerPressed="OnPttStart"
                   PointerReleased="OnPttStop"
                   Background="{Binding ConnectionStatus, Converter={StaticResource ChannelStatusToColorConverter}}">

        <!-- Wrapper Panel for both view modes -->
        <Panel>
            <!-- READ-ONLY VIEW (Default) -->
            <Grid ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  IsVisible="{Binding !IsEditing}">

                <!-- Header Row: Channel Name + Toggle + Edit Button -->
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                      ColumnDefinitions="Auto,*,Auto,Auto"
                      Margin="0,0,0,4">

                    <!-- Channel Name -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               Classes="Subtitle2"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap" />

                    <!-- Edit Button -->
                    <Button Grid.Column="3"
                            Classes="Flat"
                            Command="{Binding ToggleEditingCommand}"
                            Width="28" Height="28"
                            Padding="0"
                            ToolTip.Tip="Edit Channel"
                            IsVisible="{Binding IsEditable}">
                        <avalonia:MaterialIcon Kind="EditOutline" Width="16" Height="16" Opacity="0.6" />
                    </Button>
                </Grid>

                <!-- Frequency -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                            Margin="0,0,0, 12">
                    <TextBlock
                        Text="{Binding FrequencyMhzString, StringFormat={}{0} MHz}"
                        Classes="Headline5"
                        FontWeight="SemiBold"
                        TextWrapping="NoWrap"
                        Background="{Binding TransmissionStatus,  Converter={StaticResource ChannelTransmissionStatusToColorConverter}}"
                        IsEnabled="{Binding IsEditable}" />

                </StackPanel>

                <!-- Type, Hotkey & Status -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,0,0,12">

                    <!-- Connection Status with Dot Indicator -->
                    <Button Margin="0, 0, 0, 0"
                            BorderBrush="{DynamicResource MaterialDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,4"
                            Classes="Flat"
                            IsEnabled="{Binding IsEditable}"
                            Command="{Binding ToggleJoinLeaveCommand}">

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Connected Dot -->
                            <Ellipse Width="6" Height="6"
                                     Fill="Green"
                                     IsVisible="{Binding ConnectionStatus, Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter={x:Static models1:Channel+ChannelConnectionStatus.Connected}}" />

                            <Ellipse Width="6" Height="6"
                                     Fill="Red"
                                     IsVisible="{Binding ConnectionStatus, Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter={x:Static models1:Channel+ChannelConnectionStatus.Disconnected}}" />
                            <TextBlock Text="{Binding ConnectionStatus}"
                                       Classes="Caption" />
                        </StackPanel>
                    </Button>

                    <!-- Type Badge -->
                    <Border Background="{DynamicResource MaterialPrimaryLightBrush}"
                            CornerRadius="4"
                            Padding="8,4">
                        <Panel>
                            <!-- Calculated Type - Only in GCI Mode -->
                            <TextBlock Text="{Binding Type}"
                                       IsVisible="{Binding RadioStationData.Type,
                                   Converter={StaticResource InvertedEnumToBoolConverter},
                                   ConverterParameter={x:Static models:RadioStationData+RadioStationType.BMS}}"
                                       Classes="Body2"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />

                            <!-- BMS Radio Type - Only in BMS Mode -->
                            <TextBlock Text="{Binding BmsRadioType}"
                                       IsVisible="{Binding RadioStationData.Type,
                                   Converter={StaticResource EnumToBoolConverter},
                                   ConverterParameter={x:Static models:RadioStationData+RadioStationType.BMS}}"
                                       Classes="Body2"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </Panel>
                    </Border>

                    <!-- Clickable Hotkey Button - Click to set/change hotkey -->
                    <Button Command="{Binding BeginCaptureHotkeyCommand}"

                            BorderBrush="{DynamicResource MaterialDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,4"
                            Classes="Flat"
                            ToolTip.Tip="{Binding HasPttHotkey, Converter={StaticResource HotkeyTooltipConverter}}"
                            IsEnabled="{Binding RadioStationData.Type, 
                                 Converter={StaticResource InvertedEnumToBoolConverter}, 
                                 ConverterParameter={x:Static models:RadioStationData+RadioStationType.BMS}}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:MaterialIcon Kind="KeyboardOutline"
                                                   Width="18" Height="18" />
                            <TextBlock Text="{Binding HotkeyDisplay}"
                                       Classes="Body2"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"

                                       FontFamily="Consolas,Courier New,monospace" />
                        </StackPanel>
                    </Button>


                </StackPanel>

                <!-- Signal Strength & Squelch Indicator Row -->
                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                      ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto"
                      Margin="0,5,0,0"
                      IsVisible="{Binding Settings.Is3dMode}">

                    <!-- Signal Label with Value -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,0,0,6">
                        <TextBlock Text="Signal Strength"
                                   FontSize="11"
                                   Opacity="0.6" />
                        <TextBlock Text="{Binding SignalStrengthDbm, StringFormat={}{0:F0} dB SNR}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemAccentColor}"
                                   IsVisible="{Binding IsEditable}" />
                    </StackPanel>

                    <!-- Signal Strength Progress Bar -->
                    <ProgressBar Grid.Row="1" Grid.Column="0"
                                 Value="{Binding SignalStrengthPercent}"
                                 Maximum="100"
                                 Height="6"
                                 Margin="0,0,8,0"
                                 CornerRadius="3"
                                 Foreground="{DynamicResource SystemAccentColor}"
                                 Background="{DynamicResource MaterialDividerBrush}" />

                    <!-- Squelch Indicator - Only visible when connected -->
                    <Button Grid.Row="1" Grid.Column="1" Command="{Binding ToggleSquelchCommand}"
                            BorderBrush="{DynamicResource MaterialDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,4"
                            Classes="Flat">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:MaterialIcon Kind="Waveform"
                                                   Width="18" Height="18" />
                            <TextBlock Text="SQ ON"
                                       Classes="Body2"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsSquelchEnabled}" />
                            <TextBlock Text="SQ OFF"
                                       Classes="Body2"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsSquelchEnabled}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- ========================================== -->
            <!-- EDIT MODE (Expanded View) -->
            <!-- ========================================== -->
            <Grid ColumnDefinitions="*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  IsVisible="{Binding IsEditing}">

                <!-- Channel Details Section -->
                <StackPanel Grid.Row="1"
                            Spacing="12"
                            Margin="0,0,0,16">

                    <!-- Name Input -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Channel Name"
                                   FontSize="12"
                                   Opacity="0.7"
                                   FontWeight="Medium" />
                        <TextBox Text="{Binding Name}"
                                 PlaceholderText="Enter channel name"
                                 Classes="Outline" />
                    </StackPanel>

                    <!-- Frequency Input -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Frequency"
                                   FontSize="12"
                                   Opacity="0.7"
                                   FontWeight="Medium" />
                        <TextBox Text="{Binding FrequencyMhzString}"
                                 PlaceholderText="Enter frequency (MHz)"
                                 Classes="Outline">
                            <TextBox.KeyBindings>
                                <KeyBinding Command="{Binding ToggleEditingCommand}" Gesture="Enter" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </StackPanel>
                </StackPanel>

                <!-- Divider -->
                <Border Grid.Row="2"
                        Height="1"
                        Background="{DynamicResource MaterialDividerBrush}"
                        Margin="0,0,0,16" />

                <!-- Audio Channel Selector -->
                <StackPanel Grid.Row="3"
                            Spacing="6"
                            Margin="0,0,0,16">
                    <TextBlock Text="Pan"
                               FontSize="12"
                               Opacity="0.7"
                               FontWeight="Medium" />
                    <controls1:AudioChannelSelector Pan="{Binding Pan}" />
                </StackPanel>

                <!-- Divider -->
                <Border Grid.Row="4"
                        Height="1"
                        Background="{DynamicResource MaterialDividerBrush}"
                        Margin="0,0,0,16" />

                <!-- Quick Frequency Presets -->
                <StackPanel Grid.Row="5"
                            Spacing="6"
                            Margin="0,0,0,16">
                    <TextBlock Text="Quick Presets"
                               FontSize="12"
                               Opacity="0.7"
                               FontWeight="Medium" />
                    <UniformGrid Rows="1" Columns="2">
                        <Button Content="BMS Lobby 1"
                                Command="{Binding BmsLobby1ClickedCommand}"
                                Classes="Outline"
                                Height="36"
                                Margin="0,0,6,0" />
                        <Button Content="BMS Lobby 2"
                                Command="{Binding BmsLobby2ClickedCommand}"
                                Classes="Outline"
                                Height="36"
                                Margin="6,0,0,0" />
                    </UniformGrid>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Margin="0,8,0,0">
                    <Button Content="DELETE"
                            Command="{Binding DeleteChannelCommand}"
                            Classes="Flat"
                            Foreground="{DynamicResource MaterialValidationErrorBrush}"
                            Height="36"
                            Padding="16,0" />
                    <Button Content="SAVE"
                            Command="{Binding ToggleEditingCommand}"
                            Classes="Flat"
                            Height="36"
                            Padding="16,0" />
                </StackPanel>
            </Grid>
        </Panel>
    </controls:Card>

</UserControl>