<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:viewModels="clr-namespace:OpenFreqClient.ViewModels"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OpenFreqClient.Views.ChannelCardView"
             x:DataType="viewModels:ChannelCardViewModel"
             xmlns:converters="using:OpenFreqClient.Converters"
             xmlns:converters1="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
             xmlns:controls1="clr-namespace:OpenFreq.Client.Controls"
             xmlns:models="clr-namespace:OpenFreq.Client.Models"
             xmlns:converters2="clr-namespace:OpenFreq.Client.Converters">
    <UserControl.Resources>
        <converters:ChannelStatusToColorConverter x:Key="ChannelStatusToColorConverter" />
        <converters:BoolToGreenGrayConverter x:Key="BoolToGreenGrayConverter" />
        <converters:HotkeyTooltipConverter x:Key="HotkeyTooltipConverter" />
        <converters1:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <converters2:InvertedEnumToBoolConverter x:Key="InvertedEnumToBoolConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Active transmission state -->
        <Style Selector="controls|Card.transmitting">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>

    <!-- Main Card -->
    <controls:Card Padding="12"
                   PointerPressed="OnPttStart"
                   PointerReleased="OnPttStop"
                   Background="{Binding Status, Converter={StaticResource ChannelStatusToColorConverter}}">

        <!-- Wrapper Panel for both view modes -->
        <Panel>
            <!-- READ-ONLY VIEW (Default) -->
            <Grid ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  IsVisible="{Binding !IsEditing}">

                <!-- Channel Name & Frequency -->
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="4" IsVisible="{Binding IsEnabled}">
                    <TextBlock Text="{Binding Name}"
                               Classes="Subtitle2"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FrequencyMhzString, StringFormat={}{0} MHz}"
                               Classes="Headline6"
                               FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="4" IsVisible="{Binding !IsEnabled}">
                    <TextBlock Text="{Binding Name}"
                               Classes="Subtitle2"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialCheckBoxDisabledBrush}" />
                    <TextBlock Text="{Binding FrequencyMhzString, StringFormat={}{0} MHz}"
                               Classes="Headline6"
                               Foreground="{DynamicResource MaterialCheckBoxDisabledBrush}"
                               FontWeight="Bold" />
                </StackPanel>

                <!-- Right Side Controls Column -->
                <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="4"
                            Spacing="8"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Margin="4"
                            IsEnabled="{Binding RadioStationData.Type, 
                     Converter={StaticResource InvertedEnumToBoolConverter}, 
                     ConverterParameter={x:Static models:RadioStationData+RadioStationType.BMS}}">

                    <!-- Enable/Disable Toggle -->
                    <ToggleButton IsChecked="{Binding IsEnabled}"
                                  Width="40" Height="40"
                                  ToolTip.Tip="Enable/Disable Channel"
                                  Classes="Flat"><!-- Command="{Binding ToggleEnabledCommand}"-->
                        <avalonia:MaterialIcon Kind="Circle"
                                               Width="24" Height="24"
                                               Foreground="{Binding IsEnabled, Converter={StaticResource BoolToGreenGrayConverter}}" />
                    </ToggleButton>

                    <!-- Hotkey Button -->
                    <Button Classes="Flat"
                            Command="{Binding BeginCaptureHotkeyCommand}"
                            Width="40" Height="40"
                            ToolTip.Tip="{Binding HasHotkey, Converter={StaticResource HotkeyTooltipConverter}}"
                            IsVisible="{Binding !IsCapturingHotkey}">
                        <Grid>
                            <avalonia:MaterialIcon Kind="Keyboard"
                                                   Width="24" Height="24"
                                                   IsVisible="{Binding !HasHotkey}" />
                            <avalonia:MaterialIcon Kind="KeyboardOutline"
                                                   Width="24" Height="24"
                                                   Foreground="{DynamicResource SystemAccentColor}"
                                                   IsVisible="{Binding HasHotkey}" />
                        </Grid>
                    </Button>

                    <!-- Capturing Hotkey State -->
                    <Button Classes="Flat"
                            Width="40" Height="40"
                            IsEnabled="False"
                            IsVisible="{Binding IsCapturingHotkey}">
                        <avalonia:MaterialIcon Kind="Keyboard"
                                               Width="24" Height="24"
                                               Foreground="{DynamicResource MaterialValidationErrorBrush}" />
                    </Button>

                    <!-- Edit Button -->
                    <Button Classes="Flat"
                            Command="{Binding ToggleEditingCommand}"
                            Width="40" Height="40"
                            ToolTip.Tip="Edit Channel">
                        <avalonia:MaterialIcon Kind="Edit" Width="20" Height="20" />
                    </Button>
                </StackPanel>

                <!-- Type & Status -->
                <StackPanel Grid.Row="1" Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            Margin="4,8,4,4">
                    <Border Background="{DynamicResource MaterialPrimaryLightBrush}"
                            CornerRadius="4"
                            Padding="8,4">

                        <StackPanel>
                            <!-- Calculated Type - Only in GCI Mode -->
                            <TextBlock Text="{Binding Type}"
                                       IsVisible="{Binding RadioStationData.Type, 
                                   Converter={StaticResource InvertedEnumToBoolConverter}, 
                                   ConverterParameter={x:Static models:RadioStationData+RadioStationType.BMS}}"
                                       Classes="Caption"
                                       FontWeight="SemiBold" />

                            <!-- BMS Radio Type - Only in BMS Mode -->
                            <TextBlock Text="{Binding BmsRadioType}"
                                       IsVisible="{Binding RadioStationData.Type, 
                                   Converter={StaticResource EnumToBoolConverter}, 
                                   ConverterParameter={x:Static models:RadioStationData+RadioStationType.BMS}}"
                                       Classes="Caption"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                    </Border>
                    <TextBlock Text="{Binding Status}"
                               Classes="Caption"
                               VerticalAlignment="Center"
                               Opacity="0.7" />
                </StackPanel>

                <!-- Hotkey Display (if set) -->
                <Border Grid.Row="2" Grid.Column="0"
                        Background="{DynamicResource MaterialPrimaryLightBrush}"
                        CornerRadius="4"
                        Padding="8,4"
                        Margin="4"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding HasHotkey}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <avalonia:MaterialIcon Kind="Keyboard" Width="14" Height="14" />
                        <TextBlock Text="{Binding HotkeyDisplay}"
                                   Classes="Caption"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <!-- Signal Strength -->
                <ProgressBar Grid.Row="3" Grid.Column="0"
                             Value="{Binding SignalStrength}"
                             Margin="4,8,4,4"
                             Height="6"
                             Foreground="{DynamicResource SystemAccentColor}"
                             Background="{DynamicResource MaterialDividerBrush}" />
            </Grid>

            <!-- ========================================== -->
            <!-- EDIT MODE (Expanded View) -->
            <!-- ========================================== -->
            <Grid ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto, Auto"
                  IsVisible="{Binding IsEditing}">

                <!-- Name Input -->
                <TextBox Grid.Row="0" Grid.Column="0"
                         Text="{Binding Name}"
                         Watermark="Channel Name"
                         Classes="Outline"
                         Margin="4" />

                <!-- Frequency Input -->
                <TextBox Grid.Row="1" Grid.Column="0"
                         Text="{Binding FrequencyMhzString}"
                         Watermark="Frequency (MHz)"
                         Classes="Outline"
                         Margin="4" />

                <!-- Audio Channel Selector -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="4,8">

                    <TextBlock Text="Audio Channel"
                               Classes="Caption"
                               Opacity="0.7"
                               Margin="0,0,0,4" />
                    <controls1:AudioChannelSelector SelectedChannel="{Binding AudioChannel}" />
                </StackPanel>

                <!-- Quick Frequency Presets -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="4,8">
                    <TextBlock Text="Quick Presets"
                               Classes="Caption"
                               Opacity="0.7"
                               Margin="0,0,0,4" />
                    <UniformGrid Rows="1" Columns="2">
                        <Button Content="BMS Lobby 1"
                                Command="{Binding BmsLobby1ClickedCommand}"
                                Classes="Outline"
                                Margin="0,0,4,0" />
                        <Button Content="BMS Lobby 2"
                                Command="{Binding BmsLobby2ClickedCommand}"
                                Classes="Outline"
                                Margin="4,0,0,0" />
                    </UniformGrid>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Margin="4,8,4,4">
                    <Button Content="DELETE"
                            Command="{Binding DeleteChannelCommand}"
                            Classes="Flat"
                            Foreground="{DynamicResource MaterialValidationErrorBrush}" />
                    <Button Content="SAVE"
                            Command="{Binding ToggleEditingCommand}"
                            Classes="Flat" />
                </StackPanel>
            </Grid>
        </Panel>
    </controls:Card>

</UserControl>