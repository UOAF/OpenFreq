<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="OpenFreqClient.Views.ConfirmationDialog"
    xmlns:viewModels="clr-namespace:OpenFreqClient.ViewModels"
    x:DataType="viewModels:ConfirmationDialogViewModel">

    <StackPanel Width="360" Spacing="16">
        <!-- Title -->
        <TextBlock
            Text="{Binding Title}"
            Classes="Headline6" />

        <!-- Message -->
        <TextBlock
            Text="{Binding Message}"
            TextWrapping="Wrap" />

        <!-- Buttons -->
        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8">

            <Button
                Content="{Binding CancelText}"
                Classes="Flat"
                IsCancel="True"
                IsVisible="{Binding ShowCancel}"
                Command="{Binding CancelCommand}" />

            <Button
                Content="{Binding ConfirmText}"
                IsDefault="True"
                Classes="Flat"
                Foreground="{DynamicResource MaterialValidationErrorBrush}"
                Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
