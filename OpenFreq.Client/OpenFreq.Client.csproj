<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ApplicationIcon>openfreq_client.ico</ApplicationIcon>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <RootNamespace>openfreq-client</RootNamespace>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win')) Or ($([MSBuild]::IsOSPlatform('Windows')) And '$(RuntimeIdentifier)' == '')">
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
        <EmbeddedResource Include="Assets\airplane_icon.svg" />
    </ItemGroup>

    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win')) Or ($([MSBuild]::IsOSPlatform('Windows')) And '$(RuntimeIdentifier)' == '')">
        <None Include="..\libs\OpenFreqAudio\OpenFreqAudio\Assets\windows\*.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>%(Filename)%(Extension)</Link>
        </None>
    </ItemGroup>

    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) Or ($([MSBuild]::IsOSPlatform('Linux')) And '$(RuntimeIdentifier)' == '')">
        <None Include="..\libs\OpenFreqAudio\OpenFreqAudio\Assets\linux\*.so">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>%(Filename)%(Extension)</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.2" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="DialogHost.Avalonia" Version="0.12.2" />
        <PackageReference Include="DotSpatial.Projections" Version="4.0.656" />
        <PackageReference Include="ManagedBass" Version="4.0.2" />
        <PackageReference Include="Mapsui.Avalonia12" Version="5.1.0-beta.7" />
        <PackageReference Include="Mapsui.Rendering.Skia" Version="5.1.0-beta.7" />
        <PackageReference Include="Material.Avalonia" Version="3.16.1" />
        <PackageReference Include="Material.Avalonia.Dialogs" Version="3.16.1" />
        <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
        <PackageReference Include="Serilog" Version="4.2.0" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="SharpHook" Version="7.1.1" />
        <PackageReference Include="SkiaSharp.Svg" Version="1.60.0" />
        <PackageReference Include="Vortice.DirectInput" Version="3.8.3" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\libs\OpenFreqAudio\OpenFreqAudio\OpenFreqAudio.csproj" />
      <ProjectReference Include="..\OpenFreq.Common\OpenFreq.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
      <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
    </ItemGroup>

    <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
      <NoWarn>$(NoWarn);IL2104;IL2035</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
      <TrimmerRootAssembly Include="Serilog" />
      <TrimmerRootAssembly Include="Serilog.Extensions.Hosting" />
      <TrimmerRootAssembly Include="Serilog.Sinks.Console" />
      <TrimmerRootAssembly Include="Serilog.Sinks.File" />
      <TrimmerRootAssembly Include="DotSpatial.Projections" />
      <TrimmerRootAssembly Include="Material.Styles" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="Microsoft.Extensions.DependencyInjection">
        <HintPath>..\..\..\.nuget\packages\microsoft.extensions.dependencyinjection\9.0.10\lib\net9.0\Microsoft.Extensions.DependencyInjection.dll</HintPath>
      </Reference>
      <Reference Include="Microsoft.Extensions.Logging.Abstractions">
        <HintPath>..\..\..\.nuget\packages\microsoft.extensions.logging.abstractions\9.0.10\lib\net9.0\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Controls\AudioChannelSelector.axaml.cs">
        <DependentUpon>AudioChannelSelector.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Controls\RecordingSettingsCard.axaml.cs">
        <DependentUpon>RecordingSettingsCard.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>
</Project>
